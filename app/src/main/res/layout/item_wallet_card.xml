<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWalletContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#6200EE"> <!-- Default purple, Java changes this! -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Top Left: Bank Icon in a frosted glass circle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF"> <!-- 20% Opacity White (Frosted) -->

            <ImageView
                android:id="@+id/iconWallet"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Top Right: Account Type (e.g., Mobile Money) -->
        <TextView
            android:id="@+id/textWalletType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/ic_custom_launcher_background"
            android:backgroundTint="#33000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="Mobile Money"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Middle: Bank Name (e.g., Telebirr) -->
        <TextView
            android:id="@+id/textWalletName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/iconContainer"
            android:layout_marginTop="24dp"
            android:text="Telebirr"
            android:textColor="#E0FFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.1" />

        <!-- Bottom: Balance -->
        <TextView
            android:id="@+id/textWalletBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textWalletName"
            android:layout_marginTop="4dp"
            android:text="ETB 15,000.00"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Bottom Right: Fake Card Chip or Logo to make it look real -->
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_alignBottom="@id/textWalletBalance"
            android:src="@android:drawable/ic_secure"
            app:tint="#4DFFFFFF" /> <!-- 30% Opacity White -->

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>