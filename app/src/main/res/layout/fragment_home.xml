<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:clipToPadding="false"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- 1. THE TOP USER ROW (Profile, Home, Bell) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
            <com.google.android.material.card.MaterialCardView android:id="@+id/imgProfile" android:layout_width="40dp" android:layout_height="40dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="#9575CD">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_myplaces" app:tint="#FFFFFF"/>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:text="Home" android:textColor="#212121" android:textSize="18sp" android:textStyle="bold" />
            <ImageView android:id="@+id/btnNotifications" android:layout_width="28dp" android:layout_height="28dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:src="@android:drawable/ic_popup_reminder" app:tint="#757575" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_alignParentEnd="true" android:layout_marginTop="4dp" android:layout_marginEnd="4dp" android:background="@drawable/ic_launcher_background" android:backgroundTint="#FF3D00"/>
        </RelativeLayout>

        <!-- 2. THE NEW UNIFIED WEALTH CARD (With Gradient!) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/bg_wealth_card"> <!-- THIS APPLIES THE GRADIENT! -->

                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/labelTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Balance ˅" android:textColor="#E8EAF6" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="•••" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/textTotalBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ETB 0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <!-- Bottom Row: Income & Expense Split -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="32dp"
                    android:weightSum="2">

                    <!-- INCOME SECTION -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                            <!-- Down Arrow -->
                            <com.google.android.material.card.MaterialCardView android:layout_width="24dp" android:layout_height="24dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="0dp" android:alpha="0.2"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="-18dp"/>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Income" android:textColor="#E8EAF6" android:textSize="14sp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/textCardIncome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ETB 0.00" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- EXPENSE SECTION -->
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

                            <!-- Up Arrow -->
                            <com.google.android.material.card.MaterialCardView android:layout_width="24dp" android:layout_height="24dp" app:cardCornerRadius="12dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="0dp" android:alpha="0.2"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:layout_marginStart="-18dp"/>

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:text="Expenses" android:textColor="#E8EAF6" android:textSize="14sp"/>
                        </LinearLayout>
                        <TextView android:id="@+id/textCardExpense" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="ETB 0.00" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. ANALYTICS HEADER WITH ORANGE BUTTON -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="Analytics" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/black"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnYearFilter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#FF6D00"
                app:cardElevation="0dp">
                <TextView android:id="@+id/textYearFilter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:paddingHorizontal="12dp" android:text="Year - 2024 ˅" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Bar Chart -->
        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChart"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <!-- 4. TRANSACTIONS HEADER WITH "VIEW ALL" -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transactions" android:textSize="18sp" android:textStyle="bold" android:textColor="@android:color/black"/>
            <TextView android:id="@+id/btnViewAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="View All" android:textSize="14sp" android:textStyle="bold" android:textColor="#9E9E9E" android:background="?attr/selectableItemBackground" android:clickable="true"/>
        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>