<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7C4DFF"
    android:padding="32dp">

    <!-- App Logo / Lock Icon -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLockIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#33FFFFFF"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_secure"
            app:tint="#FFFFFF" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textPinInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Your PIN"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardLockIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NEW: CUSTOM HINT SETUP SECTION (Hidden by default, centered) -->
    <LinearLayout
        android:id="@+id/layoutHintSetup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/textPinInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Add a hint to help you remember your PIN"
            android:textColor="#E0FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="#FFFFFF"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeWidth="0dp"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editCustomHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:hint="e.g., My birth year, Last 4 digits of phone"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:textSize="14sp"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- The 4 PIN Dots -->
    <LinearLayout
        android:id="@+id/layoutPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHintSetup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.1">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dot1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dot2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dot3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dot4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33FFFFFF"/>
    </LinearLayout>

    <!-- Custom Numeric Keypad (Centered & will shrink with ConstraintLayout) -->
    <GridLayout
        android:id="@+id/keypadGrid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutPinDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.8">

        <!-- Each TextView uses the PinButton style from themes.xml -->
        <TextView android:tag="1" android:text="1" style="@style/PinButton" />
        <TextView android:tag="2" android:text="2" style="@style/PinButton" />
        <TextView android:tag="3" android:text="3" style="@style/PinButton" />

        <TextView android:tag="4" android:text="4" style="@style/PinButton" />
        <TextView android:tag="5" android:text="5" style="@style/PinButton" />
        <TextView android:tag="6" android:text="6" style="@style/PinButton" />

        <TextView android:tag="7" android:text="7" style="@style/PinButton" />
        <TextView android:tag="8" android:text="8" style="@style/PinButton" />
        <TextView android:tag="9" android:text="9" style="@style/PinButton" />

        <TextView android:text="" style="@style/PinButton" android:clickable="false" android:focusable="false"/>
        <TextView android:tag="0" android:text="0" style="@style/PinButton" />
        <TextView android:id="@+id/btnDeletePin" android:text="⌫" style="@style/PinButton" android:textSize="24sp" />
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>